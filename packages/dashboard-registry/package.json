{
  "name": "@vonzio/dashboard-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend slot registry for vonzio dashboard plugins. The register*/get* API a plugin's frontend entry calls to add integration rows, settings sections, routes, nav items, and other dashboard slots. Published so external plugins can extend the dashboard from npm.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://vonzio.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vonzio/vonzio.git",
    "directory": "packages/dashboard-registry"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./src/api.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare-dist": "node ../../scripts/prepare-sdk-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "lucide-react": "^0.474.0",
    "react": "^19.2.8"
  }
}
