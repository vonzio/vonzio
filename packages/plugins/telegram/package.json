{
  "name": "@vonzio/plugin-telegram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram integration for vonzio. POC for the plugin extraction arc -- the real telegram code is being moved here piecewise from packages/core-server and packages/dashboard.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://vonzio.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vonzio/vonzio.git",
    "directory": "packages/plugins/telegram"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "vonzio": {
    "apiVersion": "1.0",
    "backendEntry": "./src/index.ts",
    "frontendEntry": "./src/frontend.tsx",
    "schemaPrefix": "telegram",
    "routePrefix": {
      "kind": "absolute",
      "prefix": [
        "/v1/integrations/telegram",
        "/api/telegram"
      ]
    },
    "capabilities": [
      "db.access",
      "encryption.encrypt",
      "encryption.decrypt",
      "integrations.read.decrypted",
      "integrations.write",
      "profiles.read",
      "profiles.resolve",
      "workspaces.read",
      "workspaces.write",
      "auth.gate",
      "presence.register",
      "tasks.submit",
      "sessions.register",
      "sessions.extend",
      "sessions.setStatus",
      "sessions.getConnectedIds",
      "orchestrator.wake",
      "events.append",
      "events.read",
      "events.subscribe",
      "dashboard.push",
      "images.rewrite",
      "models.list",
      "notifications.channel",
      "mcp.register",
      "scheduler.run",
      "http.outbound"
    ],
    "outboundHosts": [
      "api.telegram.org",
      "api.anthropic.com"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./frontend": {
      "types": "./src/frontend.tsx",
      "import": "./src/frontend.tsx"
    },
    "./service": {
      "types": "./src/services/telegram-service.ts",
      "import": "./src/services/telegram-service.ts"
    },
    "./dashboard/api": {
      "types": "./src/dashboard/api.ts",
      "import": "./src/dashboard/api.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vonzio/dashboard": "*",
    "@vonzio/dashboard-registry": "*",
    "@vonzio/plugin-api": "*",
    "drizzle-orm": "^0.45.1",
    "marked": "^18.0.9",
    "qrcode.react": "^4.2.0",
    "zod": "^3.24.4"
  },
  "peerDependencies": {
    "fastify": "^5.11.3",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
