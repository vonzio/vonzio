{
  "name": "@vonzio/plugin-slack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slack integration for vonzio. Second plugin in the extraction arc -- validates that the @vonzio/plugin-api contract from Phase 3D generalizes to a non-Telegram chat surface.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://vonzio.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vonzio/vonzio.git",
    "directory": "packages/plugins/slack"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "vonzio": {
    "apiVersion": "1.0",
    "backendEntry": "./src/index.ts",
    "frontendEntry": "./src/frontend.tsx",
    "schemaPrefix": "slack",
    "routePrefix": {
      "kind": "absolute",
      "prefix": [
        "/v1/integrations/slack",
        "/api/slack"
      ]
    },
    "capabilities": [
      "db.access",
      "encryption.encrypt",
      "encryption.decrypt",
      "integrations.read.decrypted",
      "integrations.write",
      "profiles.read",
      "profiles.resolve",
      "workspaces.read",
      "workspaces.write",
      "auth.gate",
      "presence.register",
      "tasks.submit",
      "sessions.register",
      "sessions.extend",
      "sessions.setStatus",
      "sessions.getConnectedIds",
      "orchestrator.wake",
      "events.append",
      "events.read",
      "events.subscribe",
      "dashboard.push",
      "images.rewrite",
      "models.list",
      "notifications.channel",
      "mcp.register",
      "scheduler.run",
      "http.outbound"
    ],
    "outboundHosts": [
      "slack.com",
      "*.slack.com",
      "api.anthropic.com"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./frontend": {
      "types": "./src/frontend.tsx",
      "import": "./src/frontend.tsx"
    },
    "./dashboard/api": {
      "types": "./src/dashboard/api.ts",
      "import": "./src/dashboard/api.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vonzio/dashboard": "*",
    "@vonzio/dashboard-registry": "*",
    "@vonzio/plugin-api": "*",
    "@vonzio/shared": "*",
    "drizzle-orm": "^0.45.1",
    "slackify-markdown": "^5.0.0",
    "zod": "^3.24.4"
  },
  "peerDependencies": {
    "fastify": "^5.11.2",
    "react": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
