# Heavy base image for Vonzio agent containers. Contains everything that
# does NOT change per deploy: system packages, Chromium, global npm tooling,
# helper scripts, and the unprivileged `agent` user.
#
# Built by .github/workflows/agent-base.yml — automatically on changes to
# this file or the helper scripts it copies, plus on a weekly cron to pick
# up apt security updates. Tagged as ghcr.io/<repo>/agent-base:latest and
# :<sha>. The deploy-time docker/Dockerfile.agent uses this as its FROM.

FROM node:26-slim

# Cache-bust for the apt layers below. `apt-get upgrade` only pulls new
# debian-security patches when this RUN layer actually executes -- but a
# byte-identical RUN string is served from the buildx layer cache
# indefinitely, so once a layer is cached the upgrade never re-runs and the
# image freezes at whatever package versions it was first built with. A new
# chromium HIGH CVE then fails the Trivy gate even though the fix is already in
# bookworm-security. Referencing APT_SNAPSHOT in the RUN ties this layer's
# cache key to the value CI bumps daily (see .github/workflows/ci.yml), forcing
# a fresh apt pull. Defaults to a constant so non-CI builds are unaffected.
ARG APT_SNAPSHOT=0

# Pull the latest debian security patches into every rebuild. The
# node:22-slim base lags upstream by days-to-weeks; `apt-get upgrade`
# brings libgnutls30, linux-libc-dev, and friends current with whatever
# the security tracker has on the date of build. This is what makes the
# Trivy CI gate satisfiable -- without this step the base image carries
# whatever CVEs accumulated since node:22-slim was last rebuilt.
RUN echo "apt snapshot ${APT_SNAPSHOT}" \
    && apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# The bundled npm in node:22-slim ships an older picomatch (HIGH ReDoS).
# Upgrade npm globally so its dependency tree is patched. agent-runner
# uses npx + npm install at agent startup, so an out-of-date npm here
# means an out-of-date dep tree there.
#
# Then patch npm's OWN bundled deps (same fix as Dockerfile.server, see the
# comment there): npm@latest still vendors brace-expansion 5.0.7 and
# ip-address 10.2.0 with HIGH advisories.
RUN npm install -g npm@latest && \
    mkdir /tmp/npm-dep-patch && cd /tmp/npm-dep-patch && \
    npm install --no-audit --no-fund brace-expansion@^5.0.9 ip-address@^10.3.1 && \
    NPMDIR=/usr/local/lib/node_modules/npm/node_modules && \
    for p in brace-expansion ip-address; do \
      rm -rf "$NPMDIR/$p" && cp -r "/tmp/npm-dep-patch/node_modules/$p" "$NPMDIR/$p"; \
    done && \
    cd / && rm -rf /tmp/npm-dep-patch

# System tools for Claude Code agents.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git ca-certificates openssh-client \
    iputils-ping net-tools dnsutils \
    jq tree less vim ripgrep fd-find \
    zip unzip rsync \
    # poppler-utils gives `pdftotext` — lets agents on non-Anthropic models
    # (Ollama/OpenAI-compat) extract PDF text to a string they CAN read, since
    # those models can't ingest PDF/image content blocks the way Anthropic's
    # native Read does. ~3 MB. See the provider-aware knowledge guidance.
    poppler-utils \
    build-essential cmake pkg-config \
    python3 python3-pip python3-venv \
    # Image/asset tooling for the "Image studio" agent template: ImageMagick
    # (convert/mogrify/identify) + ffmpeg (video / animated GIF) + Pillow (PIL)
    # + DejaVu fonts for text overlays. Baked in (the agent runs unprivileged
    # with no apt at runtime) so the template works with zero setup and needs
    # no pypi egress under egress enforcement.
    imagemagick ffmpeg python3-pil fonts-dejavu-core \
    chromium \
    # Common database clients — avoids the per-session install dance for
    # agents that read/write user databases (Supabase/Postgres, MySQL,
    # Redis, SQLite). Each is small (~5-15 MB).
    postgresql-client default-mysql-client redis-tools sqlite3 \
    procps file \
    # Office-document toolchain (default-on, issue #367): the baked docx/xlsx/
    # pptx skills shell out to LibreOffice for xlsx formula recalculation,
    # docx tracked-changes acceptance, legacy .doc/.xls/.ppt conversion, and
    # PDF rendering for visual QA — the writer/calc/impress trio without
    # recommends keeps it to a fraction of full libreoffice. pandoc reads
    # docx as markdown; fonts-liberation gives metric-compatible substitutes
    # for Arial/Times/Courier so LibreOffice previews match Office layout;
    # tesseract powers the pdf skill's OCR path.
    libreoffice-writer libreoffice-calc libreoffice-impress \
    pandoc fonts-liberation tesseract-ocr \
    # Programmable tab-completion (git/apt/etc.) for the in-app Console. The
    # baked-in ~/.bashrc already sources it when present; without the package
    # only basic readline filename/command completion works.
    bash-completion \
    # Re-run `apt-get upgrade` AFTER chromium installs so any chromium
    # patch published between the line-18 upgrade and now lands too.
    # Chromium ships HIGH/CRITICAL CVEs frequently (see CVE-2026-9872+
    # batch on 2026-05-31 that gated PR #83/#84); without this step a
    # rebuild only picks up new chromium when the chromium line itself
    # gets re-cached. This step is cheap on weekly-cron rebuilds and
    # invalidates correctly on real CVE drift.
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    # Symlink fd (Debian names it fdfind).
    && ln -sf /usr/bin/fdfind /usr/bin/fd

# GitHub CLI (gh).
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# Claude Agent SDK (CLI + programmatic API).
RUN npm install -g @anthropic-ai/claude-agent-sdk agent-browser

# NOTE on version pinning: the pip/npm installs below are deliberately
# UNPINNED, matching every other install in this image — agent-base floats
# and rebuilds weekly (APT_SNAPSHOT machinery above) so security patches
# land; exact pins would freeze CVEs between manual bumps. The skills
# tarball IS pinned — by commit SHA, which pins content; GitHub tarballs
# aren't byte-stable enough for a meaningful checksum on top.
#
# Python libraries the office skills import (Debian's python3 is PEP 668
# "externally managed", hence --break-system-packages; these are container-
# global on purpose — the agent user has no runtime pip under egress
# enforcement). pandas/openpyxl/markitdown per the xlsx skill; python-docx /
# python-pptx / defusedxml for OOXML work; pypdf + pdf2image + pytesseract
# for the pdf skill.
RUN pip3 install --no-cache-dir --break-system-packages \
    python-docx python-pptx openpyxl pandas markitdown defusedxml \
    pypdf pdf2image pytesseract

# Node libraries the docx/pptx skills `require()` from generated scripts:
# docx + pptxgenjs generators, react/react-dom/react-icons + sharp for the
# icon-rasterization path. Installed to the root prefix (/usr/local) and
# exposed via NODE_PATH so `require("docx")` resolves from /workspace.
RUN npm install -g --prefix /usr/local docx pptxgenjs react react-dom react-icons sharp

# Anthropic's Apache-2.0 agent skills for office files (docx/xlsx/pptx/pdf),
# vendored at a pinned commit. Baked to a neutral path — /home/agent/.claude
# is often a mounted volume, so the orchestrator seeds these into
# ~/.claude/skills at session setup rather than relying on image contents.
ARG SKILLS_COMMIT=f17010c9bb483898c1d9c9f42dde2b3a98889434
RUN mkdir -p /opt/vonzio/skills && cd /tmp \
    && curl -fsSL "https://github.com/anthropics/skills/archive/${SKILLS_COMMIT}.tar.gz" -o skills.tar.gz \
    && tar -xzf skills.tar.gz \
    && for s in docx xlsx pptx pdf; do cp -r "skills-${SKILLS_COMMIT}/skills/$s" /opt/vonzio/skills/; done \
    && cp "skills-${SKILLS_COMMIT}/THIRD_PARTY_NOTICES.md" /opt/vonzio/skills/ \
    && rm -rf skills.tar.gz "skills-${SKILLS_COMMIT}"

# Common global tooling. yarn/pnpm come via corepack — which node >= 25 no
# longer BUNDLES (it moved out of the runtime distribution), so install it
# explicitly before enabling.
RUN npm install -g corepack && corepack enable && \
    npm install -g \
    typescript \
    tsx \
    vite \
    create-vite \
    prettier \
    eslint

# Helper scripts that ride along with every agent container. These rarely
# change; landing them in base means agent rebuilds don't need to re-copy.
COPY docker/cleanup.sh /app/cleanup.sh
COPY docker/ollama-proxy.cjs /app/ollama-proxy.cjs
COPY docker/llm-gateway.cjs /app/llm-gateway.cjs
COPY docker/git-credential-helper.sh /app/git-credential-helper.sh
COPY docker/entrypoint.sh /app/entrypoint.sh
COPY docker/fileserver.py /app/fileserver.py
RUN chmod +x /app/cleanup.sh /app/git-credential-helper.sh /app/entrypoint.sh
RUN git config --system credential.helper /app/git-credential-helper.sh

# Unprivileged agent user (claude-agent-sdk's bypassPermissions refuses to
# run as root) + workspace + npm-global prefix.
#
# Deliberately NO sudo and no sudoers entry. The agent runs strictly as the
# unprivileged `agent` user with no path to root inside the container. If a
# deployer needs runtime apt installs they should bake them into a custom
# agent image (the supported extension point) rather than handing the LLM
# root-equivalent power — see docs/HARDENING.md.
RUN useradd -m -s /bin/bash agent && \
    mkdir -p /workspace

RUN mkdir -p /home/agent/.npm-global && chown agent:agent /home/agent/.npm-global

# Agent user shell config.
RUN echo 'export NPM_CONFIG_PREFIX=/home/agent/.npm-global' >> /home/agent/.bashrc && \
    echo 'export PATH=/home/agent/.npm-global/bin:$PATH'   >> /home/agent/.bashrc && \
    echo 'export CHROME_PATH=/usr/bin/chromium'            >> /home/agent/.bashrc && \
    echo 'export PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium' >> /home/agent/.bashrc && \
    chown agent:agent /home/agent/.bashrc

ENV CHROME_PATH=/usr/bin/chromium
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV NPM_CONFIG_PREFIX=/home/agent/.npm-global
ENV PATH=/home/agent/.npm-global/bin:$PATH
# Resolve the baked office-skill node libs (and any agent-installed globals)
# from scripts run anywhere in /workspace.
ENV NODE_PATH=/home/agent/.npm-global/lib/node_modules:/usr/local/lib/node_modules

# Chromium where Chrome DevTools MCP expects to find it.
RUN mkdir -p /opt/google/chrome && ln -sf /usr/bin/chromium /opt/google/chrome/chrome

# /app exists; agent-runner code is layered on top by docker/Dockerfile.agent.
# We deliberately do NOT set USER or ENTRYPOINT here so the agent layer can
# COPY files as root, then drop privilege in its own final layer.
WORKDIR /app
