# vonzio environment template
#
# Copy to .env and fill in. See docs/SELF_HOST.md for the full reference.
# Three REQUIRED secrets: ENCRYPTION_KEY, BETTER_AUTH_SECRET,
# POSTGRES_PASSWORD. compose hard-fails at startup if any is missing.
# Everything else has a sensible default for single-user OSS mode.

# ─── REQUIRED ──────────────────────────────────────────────────────────────
# 32+ random characters each. Generate with:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
# Postgres superuser password for the compose-managed postgres container.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# ─── Database ──────────────────────────────────────────────────────────────
# For HOST mode (not compose). The compose stack derives DATABASE_URL
# from POSTGRES_PASSWORD above and ignores this line.
DATABASE_URL=postgres://vonzio:vonzio_dev@localhost:5432/vonzio

# ─── Server ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0
# Public URL where the dashboard is reachable. For OSS the default is
# localhost:5173 (vite dev server, exposed by docker-compose.dev.yml).
# Change to your real domain in production.
BETTER_AUTH_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Single-user OSS. Set to "true" only if you wire your own multi-tenant overlay.
REGISTRATION_ENABLED=false

# Cross-subdomain session cookie. Leave unset for single-host deployments
# (the default). Set with a leading dot if you serve the app across
# subdomains (e.g. app + admin) and want both to share the login session.
#   Dev example:  .app.localhost
#   Prod example: .example.com
# COOKIE_DOMAIN=

# ─── Agents / Docker ───────────────────────────────────────────────────────
DOCKER_ENABLED=true
AGENT_IMAGE=vonzio-agent:latest

# ─── Optional: email (Resend) ──────────────────────────────────────────────
# Without this, the "Forgot password" link is hidden from /login.
# RESEND_API_KEY=
# EMAIL_FROM=vonzio <noreply@example.com>

# ─── Optional: Ollama Cloud surface ────────────────────────────────────────
# Set to "true" to show Ollama Cloud as a credential option in /onboarding.
# OLLAMA_ENABLED=true
# Upstream for the Ollama provider (model list + the agent's LLM calls via the
# in-container proxy). Defaults to Ollama Cloud; override to point at a private/
# enterprise Ollama or any Anthropic-compatible gateway. The E2E chat suite
# sets this to its mock.
# OLLAMA_BASE_URL=https://ollama.com

# ─── Optional: OpenAI / OpenAI-compatible surface ──────────────────────────
# vonzio's runner speaks the Anthropic Messages API; the in-container
# llm-gateway translates it to OpenAI Chat Completions. Upstream for the
# "openai" provider (model list + the agent's LLM calls). Defaults to OpenAI;
# override to point at any OpenAI-compatible endpoint (Azure OpenAI gateway,
# OpenRouter, a local vLLM/LM Studio server, etc.).
# OPENAI_BASE_URL=https://api.openai.com

# ─── Optional: OAuth login providers (Better Auth social sign-in) ──────────
# Fill in both client id and secret per provider to enable.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=

# ─── Optional: Git provider OAuth (for agent repo access) ──────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=

# ─── Optional: GitHub App (per-repo selection, clean org approval) ──────────
# Preferred over the OAuth App above for org repos: a GitHub App is installed
# per account/org with per-repo selection, approved by an org owner during
# install, and issues short-lived installation tokens. Avoids "OAuth App
# access restrictions" 403s. Create one at github.com/settings/apps/new with
# the "Setup URL" set to  <BETTER_AUTH_URL>/api/git/app/callback  and
# "Redirect on update" enabled. Paste the PEM with literal \n escapes or as a
# real multi-line value.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=

# ─── Optional: Slack integration ───────────────────────────────────────────
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# ─── Optional: Telegram bot ────────────────────────────────────────────────
# PLATFORM_TELEGRAM_BOT_TOKEN=
# PLATFORM_TELEGRAM_WEBHOOK_SECRET=

# ─── Optional: Gmail integration ───────────────────────────────────────────
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=

# Teller (banking) is now the external @vonzio/plugin-teller plugin — its TELLER_*
# env + mTLS cert provisioning are documented in that plugin's README.

# ─── Optional: Cloudflare Turnstile (signup captcha — only matters if
# REGISTRATION_ENABLED=true) ───────────────────────────────────────────────
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ─── Optional: Agent knowledge documents (mounted at /knowledge) ───────────
# Per-file and per-agent total caps (megabytes). Documents are stored base64
# in Postgres, so larger values grow the DB — raise with that in mind.
# MAX_DOCUMENT_MB=100
# MAX_PROFILE_DOCUMENTS_MB=500
